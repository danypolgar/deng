%% Architecture v0.1: Polymarket Calibration Pipeline
%% Port of architecture-v0.1.excalidraw. Solid = final cloud path, dashed = local/midterm path.
flowchart LR
  subgraph SRC[Polymarket public REST]
    gamma[Gamma API<br/>markets · events]
    clob[CLOB API<br/>price history]
  end

  subgraph ORCH[Kestra orchestrator: daily schedule · retries · backfills]
    ingest[Batch ingestion<br/>paginated · throttled]
    gcs[(GCS data lake, final<br/>raw JSON / load_date)]
    pg[(PostgreSQL, midterm<br/>raw JSONB + staging)]
    transform[Transform + DQ<br/>SQL / dbt]
  end

  bq[(BigQuery<br/>dim_market · dim_event<br/>fct_price_daily · snapshot<br/>calibration mart)]
  analyst([Analyst<br/>calibration / ML])

  docker[Docker Compose: ingestion · Kestra · PostgreSQL]
  tf[Terraform: GCS bucket + BigQuery dataset]

  gamma --> ingest
  clob --> ingest
  ingest --> gcs
  ingest -.-> pg
  gcs --> transform
  pg -.-> transform
  transform --> bq
  bq --> analyst
  tf -.-> bq
  docker -.- ORCH
