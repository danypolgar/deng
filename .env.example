# Copy to .env (`cp .env.example .env`). .env is git-ignored; never commit real secrets.
# The Polymarket APIs are public and need no API key.

# --- Pipeline database (PostgreSQL) ---
PG_DATABASE=polymarket
PG_USER=polymarket
PG_PASSWORD=change-me-pg
PG_HOST_PORT=5433            # host port for psql / DB tools (container port is 5432)

# --- Kestra ---
KESTRA_HOST_PORT=8080
KESTRA_USER=admin@kestra.io  # must be a valid email address
KESTRA_PASSWORD=ChangeMe123  # min. 8 characters, with an uppercase letter and a number
KESTRA_DB_PASSWORD=change-me-kestra

# --- Pipeline behaviour (optional; defaults shown) ---
LOOKBACK_DAYS=30             # initial backfill window and max. incremental look-back
OVERLAP_MINUTES=15           # incremental runs re-read this much before the watermark
CLOB_WORKERS=4               # parallel price-history requests
REQUEST_INTERVAL_SECONDS=0.15
